# JobEaseAI Configuration
PORT=3000
NODE_ENV=development

# AI Provider Keys (Waterfall order: Groq -> Gemini -> OpenAI -> Built-in Heuristic)
# 1. Groq (Free Tier at console.groq.com) - Ultra-fast (Llama 3.3 70B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini (Free Tier at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. OpenAI (Optional)
OPENAI_API_KEY=
