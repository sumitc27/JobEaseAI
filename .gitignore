# ==============================================================================
# JobEaseAI .gitignore
# ==============================================================================

# Dependencies
node_modules/
package-lock.json

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Local Executables & Heavy Compilers
tectonic.exe
*.exe
*.bin
*.dll

# Build & Bundler Artifacts
dist/
build/
.next/
out/
coverage/

# Next.js / TypeScript Scaffold Remnants (Unused in pure Node.js runtime)
next-env.d.ts
next.config.*
tsconfig.json
postcss.config.*
eslint.config.*
src/

# Temporary Files, Logs & Scratch Files
uploads/
*.tmp
*.log
Latest (1).tex
*.tex.bak

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE, Editor & Agent Directories
.vscode/
.idea/
*.swp
*.swo
.agents/
.gemini/